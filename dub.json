{
	"name": "tapotun",
	"dependencies": {
		"utile": ">=2.0.2"
	},
	"buildTypes": {
		"release-default": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"noBoundsCheck"
			],
			"dflags": [
				"-O3"
			]
		},
		"release-lto": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"noBoundsCheck"
			],
			"dflags": [
				"-O3"
			],
			"dflags-linux-aarch64": [
				"-flto=full"
			],
			"lflags-linux-aarch64": [
				"$PACKAGE_DIR/curl/libcurl-impersonate_${ARCH}_lto.a",
				"--lto=full",
				"--lto-O3"
			]
		}
	},
	"dflags-linux": [
		"-static",
		"--frame-pointer=none"
	],
	"lflags-linux": [
		"-s"
	],
	"dflags-linux-aarch64": [
		"-mcpu=cortex-a53"
	]
}
