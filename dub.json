{
	"name": "tapotun",
	"dependencies": {
		"utile": ">=2.9.2",
		"utile:tun": "*",
		"utile:web": "*",
		"utile:curl": "*"
	},
	"environments": {
		"CC": "clang -fuse-ld=lld -w"
	},
	"buildTypes": {
		"release-default": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"noBoundsCheck"
			],
			"dflags": [
				"-O3"
			],
			"lflags-linux": [
				"-s"
			]
		},
		"release-lto": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"noBoundsCheck"
			],
			"dflags": [
				"-O3"
			],
			"dflags-linux-aarch64": [
				"-flto=full"
			],
			"lflags-linux-aarch64": [
				"--lto=full",
				"--lto-O3"
			]
		}
	},
	"dflags-linux": [
		"-static",
		"--frame-pointer=none"
	],
	"dflags-linux-aarch64": [
		"-mcpu=cortex-a53"
	]
}
