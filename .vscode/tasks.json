{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "debug",
			"type": "shell",
			"command": "dub build -a x86_64",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "release",
			"type": "shell",
			"command": "dub build -b release-nobounds -a x86_64 --compiler=ldc2",
			"group": "build"
		},
		{
			"label": "test",
			"type": "shell",
			"command": "start cmd -argumentlist '/c dub run & pause'",
			"group": {
				"kind": "test",
				"isDefault": true
			}
		}
	]
}
